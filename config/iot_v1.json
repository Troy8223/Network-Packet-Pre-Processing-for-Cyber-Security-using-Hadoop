{
  "schema_version": "v1",
  "name": "iot_v1",
  "description": "IoT-oriented flows: MAC, service hint, IAT/size stats, TCP flags, bidirectional key",
  "extends": "default",
  "bidirectional": true,
  "include": {
    "packet": [
      "ts",
      "iat",
      "src_ip",
      "dest_ip",
      "src_mac",
      "dest_mac",
      "src_port",
      "dest_port",
      "protocol",
      "protocol_type",
      "ip_version",
      "ip_len",
      "frame_len",
      "payload_len",
      "ttl",
      "tcp_syn",
      "tcp_ack",
      "tcp_fin",
      "tcp_rst",
      "tcp_psh",
      "iot_service"
    ],
    "flow": [
      "first_ts",
      "last_ts",
      "duration",
      "src_mac",
      "dest_mac",
      "src_ip",
      "dest_ip",
      "src_port",
      "dest_port",
      "protocol",
      "iot_service",
      "packets",
      "packets_fwd",
      "packets_bwd",
      "bytes",
      "bytes_fwd",
      "bytes_bwd",
      "iat_min",
      "iat_max",
      "iat_mean",
      "iat_std",
      "size_min",
      "size_max",
      "size_mean",
      "size_std",
      "syn_count",
      "ack_count",
      "fin_count",
      "rst_count",
      "psh_count",
      "ttl_mean"
    ]
  }
}
